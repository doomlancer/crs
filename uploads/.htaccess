# Schutz für das Upload-Verzeichnis.
# Hier greift <FilesMatch> korrekt, weil es auf den Dateinamen im aktuellen
# Verzeichnis angewendet wird (im Gegensatz zur Root-.htaccess).

# 1) PHP-Interpreter in diesem Verzeichnis komplett abschalten
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# 2) Handler entfernen (greift auch bei PHP-FPM / mod_proxy_fcgi,
#    wo php_flag nicht zur Verfügung steht)
<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .asp .sh
    RemoveType    .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>
SetHandler none

# 3) Ausführbare Dateitypen grundsätzlich sperren
<FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|asp|aspx|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4) Alles hier wird als Download/Bild ausgeliefert, nie als HTML interpretiert
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'; sandbox"
</IfModule>
