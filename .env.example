# ─────────────────────────────────────────────────────────────
# Kameruner-Tickets – Umgebungsvariablen
# Für Docker: kopiere diese Datei nach ".env" und passe die Werte an:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Host-Port, unter dem die App erreichbar ist (Docker) ──
APP_PORT=8080

# ─────────────────────────────────────────────────────────────
# Automatische Updates (GitHub Actions + Watchtower)
# ─────────────────────────────────────────────────────────────
# Das Image wird bei jedem Push auf main automatisch gebaut und hier abgelegt.
APP_IMAGE=ghcr.io/doomlancer/crs:latest

# Wie oft Watchtower nach einer neuen Version schaut (Sekunden).
WATCHTOWER_INTERVAL=300

# Alternative zum Intervall: feste Uhrzeit statt Dauertakt.
# Empfehlenswert für Veranstaltungstage, damit der Einlass nicht durch einen
# Neustart unterbrochen wird. Beispiel = täglich um 4 Uhr nachts.
# Wenn gesetzt, wird WATCHTOWER_INTERVAL ignoriert.
#WATCHTOWER_SCHEDULE=0 0 4 * * *

# Docker-API-Version, mit der Watchtower den Daemon anspricht. Nur anfassen,
# wenn im Watchtower-Log "client version ... is too old" steht – dann auf die
# dort geforderte Mindestversion anheben.
#DOCKER_API_VERSION=1.41

# Zugangsdaten für die private Registry.
# GHCR_TOKEN = GitHub Personal Access Token (classic) mit Berechtigung
# "read:packages". Anlegen unter:
#   GitHub → Settings → Developer settings → Personal access tokens (classic)
GHCR_USER=doomlancer
GHCR_TOKEN=

# Zeitzone für Logs und Zeitpläne
TZ=Europe/Berlin

# ── Datenbank ──
# Docker: DB_HOST muss "db" sein (Name des DB-Containers).
# Klassisches Hosting: DB_HOST=localhost
DB_HOST=db
DB_NAME=crs
DB_USER=crs
DB_PASS=BitteAendern-DB-Passwort
DB_ROOT_PASS=BitteAendern-Root-Passwort

# ── Anwendung ──
APP_NAME="Kameruner-Tickets"
# Öffentliche Adresse der App (für PayPal-Rücksprünge & Links wichtig):
#   lokal:        http://192.168.1.50:8080
#   hinter Proxy: https://tickets.deine-domain.de
APP_URL=http://192.168.1.50:8080
TICKET_PREIS=15.00
DEBUG_MODE=false

# HTTPS-Zwang:
#   false = lokaler HTTP-Zugriff erlaubt (Direktzugriff ohne Proxy)
#   true  = hinter Reverse-Proxy mit TLS (SWAG / NPM / Cloudflare / Traefik)
FORCE_HTTPS=false

# ── Erster Admin-Benutzer (nur beim allerersten Start angelegt) ──
ADMIN_EMAIL=admin@die-kameruner.de
ADMIN_PASSWORD=BitteAendern-Admin-Passwort
ADMIN_VORNAME=Admin
ADMIN_NACHNAME=Kameruner

# ── Signaturschlüssel der Ticket-QR-Codes ──
# Jedes Ticket trägt eine HMAC-Signatur; ohne sie wird es beim Check-in
# abgelehnt. Wer diesen Wert kennt, kann beliebige Tickets fälschen – er darf
# also niemals ins Repository, in ein Backup-Archiv oder unter uploads/.
# Leer lassen ist zulässig: dann erzeugt die App den Schlüssel selbst und legt
# ihn oberhalb der DocumentRoot ab (Docker: Volume app_secrets).
# Eigenen Wert erzeugen mit:  openssl rand -hex 32
# ACHTUNG: Ändern macht alle bereits versendeten QR-Codes ungültig.
TICKET_SECRET=

# ── PayPal (optional – leer lassen schaltet den PayPal-Weg ab) ──
PAYPAL_EMAIL=
PAYPAL_SANDBOX=false

# ── E-Mail / SMTP (optional – leer lassen = kein Mailversand) ──
# Beispiel für ein die-kameruner.de-Postfach:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=Kassierer@die-kameruner.de
SMTP_PASS=
SMTP_STARTTLS=on
SMTP_FROM_NAME="Kameruner-Tickets"
