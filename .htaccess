# Karneval Reservierungssystem - Apache Konfiguration

# PHP-Fehlerseiten
ErrorDocument 403 /pages/error_403.php
ErrorDocument 404 /pages/error_404.php

# PHP-Ausführung in uploads/ blockieren; Bilddateien bleiben zugänglich.
# Hinweis: <FilesMatch> prüft NUR den Dateinamen, nie den Pfad – ein Muster wie
# "^uploads/..." greift dort niemals. Der eigentliche Schutz steht daher in
# uploads/.htaccess; hier zusätzlich als Rewrite-Regel (Defense in Depth).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|asp|sh)$ - [F,L]
</IfModule>

# Versionsverwaltung sperren. <FilesMatch> greift nur auf Dateinamen, nicht auf
# Pfade – ".git/config" fiele also durch jedes Muster unten. Beim Deployment per
# "git pull" direkt in den Web-Root (Plesk/FTP-Weg) ließe sich sonst über
# /.git/ die komplette Quellcode-Historie samt aller je committeten
# Konfigurationen herunterladen.
RedirectMatch 404 /\.git(/|$)

# Sensible Dateien sperren
<FilesMatch "\.(sql|log|env|ini|conf|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS nur auf echten HTTPS-Antworten. Über HTTP ignorieren Browser den
    # Header ohnehin; die Bedingung verhindert zusätzlich, dass er beim reinen
    # LAN-Betrieb (http://SERVER-IP:8080) je gesetzt wird. Läuft die App hinter
    # einem Reverse-Proxy, der TLS terminiert, gehört der Header dorthin – der
    # Container sieht die Verbindung dann als HTTP.
    # Achtung: Einmal ausgeliefert, erzwingt max-age ein Jahr lang HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    # camera=(self): nötig für den QR-Scanner des Kassierers
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self)"
    # Die Content-Security-Policy wird in config.php gesetzt (Nonce pro Request).
    # Sie darf hier NICHT zusätzlich stehen – zwei CSP-Header werden kombiniert
    # (jeweils restriktivste gewinnt) und würden die Nonce-Freigabe aufheben.
</IfModule>

# Caching für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>
